generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  username               String?           @unique
  password               String
  firstName              String?
  lastName               String?
  phone                  String?
  avatar                 String?
  role                   UserRole          @default(USER)
  status                 UserStatus        @default(PENDING_VERIFICATION)
  emailVerified          Boolean           @default(false)
  phoneVerified          Boolean           @default(false)
  lastLoginAt            DateTime?
  lastLoginIp            String?
  lastLoginUserAgent     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  mentorId               String?
  auditLogs              AuditLog[]
  createdContractGames   ContractGame[]    @relation("CreatedContractGames")
  hostedContracts        Contract[]        @relation("ContractHost")
  ownedContracts         Contract[]        @relation("ContractOwner")
  invitedBy              InviteLink?       @relation("InvitedUsers")
  inviteLinks            InviteLink[]      @relation("InviteLinks")
  mentorProfile          MentorProfile?
  payouts                Payout[]
  mentorRequests         PurchaseRequest[] @relation("MentorPurchaseRequests")
  purchaseRequests       PurchaseRequest[] @relation("UserPurchaseRequests")
  hostedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestHost")
  refreshTokens          RefreshToken[]
  sessions               Session[]
  hostedUnits            Unit[]            @relation("UnitHost")
  mentoredUnits          Unit[]            @relation("UnitMentor")
  ownedUnits             Unit[]
  permissions            UserPermission[]
  mentor                 User?             @relation("UserMentor", fields: [mentorId], references: [id])
  mentees                User[]            @relation("UserMentor")
  vendorProfile          VendorProfile?
  wallet                 Wallet?
  products               Product[]
  orders                 Order[]
  vendorOrders           Order[]           @relation("VendorOrders")
  settlements            Settlement[]
  cartItems              CartItem[]
  wishlistItems          WishlistItem[]

  @@map("users")
}

model VendorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  businessName  String
  businessType  String
  description   String?
  website       String?
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  taxId         String?
  taxIdProof    String?
  cinNumber     String?
  cinProof      String?
  licenseNumber String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vendor_profiles")
}

model MentorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  expertise    String[]
  experience   Int
  bio          String?
  hourlyRate   Float?
  availability String?
  isVerified   Boolean  @default(false)
  rating       Float?
  totalReviews Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profiles")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[] @relation("PermissionToRole")

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    String
  action      String
  users       UserPermission[]
  roles       Role[]           @relation("PermissionToRole")

  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  grantedAt    DateTime   @default(now())
  grantedBy    String?
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model Session {
  id           String        @id @default(cuid())
  userId       String
  sessionId    String        @unique
  refreshToken String        @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  location     String?
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  lastUsedAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  action     ActionType
  resource   String?
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  level      LogLevel   @default(INFO)
  message    String
  metadata   Json?
  createdAt  DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model RateLimit {
  id          String   @id @default(cuid())
  identifier  String
  endpoint    String
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([identifier, endpoint, windowStart])
  @@map("rate_limits")
}

model ContractGame {
  id               String             @id @default(cuid())
  name             String
  downPayment      Decimal            @db.Decimal(10, 2)
  status           ContractGameStatus @default(ACTIVE)
  createdById      String
  payoutStage1     Decimal            @db.Decimal(10, 2)
  payoutStage2     Decimal            @db.Decimal(10, 2)
  payoutStage3     Decimal            @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        User               @relation("CreatedContractGames", fields: [createdById], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[]
  units            Unit[]

  @@index([status])
  @@index([createdById])
  @@map("contract_games")
}

model Unit {
  id              String       @id @default(cuid())
  contractGameId  String
  ownerId         String
  unitNumber      Int
  unitName        String
  stage           Int          @default(1)
  isActive        Boolean      @default(false)
  isCompleted     Boolean      @default(false)
  parentUnitId    String?
  level           Int
  positionInLevel Int
  completedAt     DateTime?
  mentorId        String?
  hostId          String?
  isSystemRoot    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payouts         Payout[]
  contractGame    ContractGame @relation(fields: [contractGameId], references: [id], onDelete: Cascade)
  host            User?        @relation("UnitHost", fields: [hostId], references: [id])
  mentor          User?        @relation("UnitMentor", fields: [mentorId], references: [id])
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentUnit      Unit?        @relation("UnitTree", fields: [parentUnitId], references: [id], onDelete: Cascade)
  childrenUnits   Unit[]       @relation("UnitTree")

  @@unique([contractGameId, ownerId, unitNumber])
  @@unique([contractGameId, unitName])
  @@index([contractGameId, ownerId, isActive])
  @@index([parentUnitId, level, positionInLevel])
  @@index([contractGameId, stage])
  @@index([ownerId])
  @@index([isActive, stage])
  @@index([mentorId])
  @@index([hostId])
  @@index([contractGameId, isSystemRoot, stage])
  @@map("units")
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  userId         String
  mentorId       String
  hostId         String? // Host selected by mentor during approval
  contractGameId String
  unitCount      Int                   @default(4)
  totalAmount    Decimal               @db.Decimal(10, 2)
  status         PurchaseRequestStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  approvedAt     DateTime?
  placedAt       DateTime?
  cooldownEndsAt DateTime? // NEW: 14 days from placedAt
  refundedAt     DateTime? // NEW: When refund was processed
  contractGame   ContractGame          @relation(fields: [contractGameId], references: [id], onDelete: Cascade)
  mentor         User                  @relation("MentorPurchaseRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  user           User                  @relation("UserPurchaseRequests", fields: [userId], references: [id], onDelete: Cascade)
  host           User?                 @relation("PurchaseRequestHost", fields: [hostId], references: [id])

  @@index([mentorId, status])
  @@index([userId, status])
  @@index([contractGameId])
  @@index([status])
  @@index([hostId])
  @@index([cooldownEndsAt]) // NEW: For querying active cooldowns
  @@map("purchase_requests")
}

model Payout {
  id         String    @id @default(cuid())
  userId     String
  amount     Decimal   @db.Decimal(10, 2)
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  creditedAt DateTime?
  heldUntil  DateTime? // NEW: Payout held until cooldown ends
  unitId     String
  walletId   String?
  stage      Int
  unit       Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unitId])
  @@index([status])
  @@index([walletId])
  @@index([heldUntil]) // NEW: For querying held payouts
  @@map("payouts")
}

model Wallet {
  id             String        @id @default(cuid())
  userId         String        @unique
  balance        Float         @default(0)
  totalEarned    Float         @default(0)
  totalWithdrawn Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id            String   @id @default(cuid())
  walletId      String
  userId        String
  type          String
  amount        Float
  status        String   @default("COMPLETED")
  referenceId   String?
  referenceType String?
  description   String?
  createdAt     DateTime @default(now())
  wallet        Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([status])
  @@map("transactions")
}

model InviteLink {
  id            String    @id @default(cuid())
  inviterId     String
  inviteCode    String    @unique
  inviteUrl     String    @unique
  isActive      Boolean   @default(true)
  maxUses       Int?
  currentUses   Int       @default(0)
  expiresAt     DateTime?
  invitedUserId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastUsedAt    DateTime?
  invitedUser   User?     @relation("InvitedUsers", fields: [invitedUserId], references: [id])
  inviter       User      @relation("InviteLinks", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([inviteCode])
  @@index([isActive])
  @@map("invite_links")
}

model Contract {
  id              String         @id @default(cuid())
  contractNumber  Int
  ownerId         String
  hostId          String?
  parentId        String?
  stage           ContractStage  @default(STAGE_1)
  status          ContractStatus @default(ACTIVE)
  level           Int
  position        Int
  positionInLevel Int
  isActive        Boolean        @default(true)
  isActiveUnit    Boolean        @default(false)
  fulfilledAt     DateTime?
  movedToStage2At DateTime?
  movedToStage3At DateTime?
  purchasePrice   Float?         @default(0)
  downPayment     Float?         @default(0)
  payoutAmount    Float?         @default(0)
  paidOut         Boolean        @default(false)
  paidOutAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  host            User?          @relation("ContractHost", fields: [hostId], references: [id])
  owner           User           @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parent          Contract?      @relation("ContractTree", fields: [parentId], references: [id])
  children        Contract[]     @relation("ContractTree")

  @@index([ownerId])
  @@index([hostId])
  @@index([parentId])
  @@index([status])
  @@index([stage])
  @@index([ownerId, isActiveUnit])
  @@map("contracts")
}

model ContractPricing {
  id        String        @id @default(cuid())
  stage     ContractStage @unique
  price     Float
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contract_pricing")
}

enum UserRole {
  USER
  VENDOR
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

enum ActionType {
  LOGIN
  LOGOUT
  REGISTER
  UPDATE_PROFILE
  CHANGE_PASSWORD
  RESET_PASSWORD
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  ASSIGN_ROLE
  REVOKE_ROLE
  CREATE_SESSION
  REVOKE_SESSION
  API_CALL
  SYSTEM_EVENT
}

enum ContractStage {
  STAGE_1
  STAGE_2
  STAGE_3
  COMPLETED
}

enum ContractStatus {
  ACTIVE
  FULFILLED
  INACTIVE
}

enum ContractGameStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PLACED
}

enum OrderStatus {
  PENDING_VENDOR_APPROVAL
  PENDING_USER_APPROVAL
  ACCEPTED
  REJECTED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  FAILED
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  description   String?
  slug          String        @unique
  image         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories Subcategory[]
  products      Product[]

  @@index([isActive])
  @@map("categories")
}

model Subcategory {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  description String?
  slug        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@map("subcategories")
}

model Product {
  id            String         @id @default(cuid())
  vendorId      String
  categoryId    String
  subcategoryId String
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  currency      String         @default("CAD")
  stock         Int            @default(0)
  images        String[] // Array of 5 image URLs
  sku           String?        @unique
  attributes    Json? // Category-specific attributes (brand, color, size, etc.)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendor        User           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory    @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
  @@index([sku])
  @@map("products")
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  vendorId        String
  orderNumber     String      @unique
  totalAmount     Decimal     @db.Decimal(10, 2)
  currency        String      @default("CAD")
  status          OrderStatus @default(PENDING_VENDOR_APPROVAL)
  shippingAddress Json? // Full address object
  shippingName    String?
  shippingPhone   String?
  notes           String?
  proposedDeliveryDate DateTime? // Date proposed by vendor when accepting
  userApprovedDate     Boolean?  // Whether user approved the delivery date
  confirmedAt     DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor          User        @relation("VendorOrders", fields: [vendorId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  settlement      Settlement?

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // Price at time of order
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Settlement {
  id        String           @id @default(cuid())
  vendorId  String
  orderId   String           @unique
  amount    Decimal          @db.Decimal(10, 2)
  currency  String           @default("CAD")
  status    SettlementStatus @default(PENDING)
  settledAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  vendor    User             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("settlements")
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}
