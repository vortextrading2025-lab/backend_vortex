# ==========================================
# PRODUCTION ENVIRONMENT
# ==========================================

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Use separate production database
DATABASE_URL="postgresql://postgres:PRODUCTION_PASSWORD@production-db.railway.app:5432/vortexbonus_prod"

# ==========================================
# JWT CONFIGURATION
# ==========================================
# Generate NEW production secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_NEW_PRODUCTION_SECRET_HERE"
JWT_REFRESH_SECRET="GENERATE_NEW_PRODUCTION_REFRESH_SECRET_HERE"
JWT_EXPIRE="15m"
JWT_REFRESH_EXPIRE="7d"

# ==========================================
# REDIS/UPSTASH CONFIGURATION
# ==========================================
# Use separate production Redis instance
UPSTASH_REDIS_REST_URL="https://production-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="PRODUCTION_REDIS_TOKEN_HERE"

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV="production"
API_URL="https://api.vortexbonus.com"

# ==========================================
# CORS CONFIGURATION
# ==========================================
ALLOWED_ORIGINS="https://vortexbonus.com,https://www.vortexbonus.com,https://api.vortexbonus.com"

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL="error"

# ==========================================
# RATE LIMITING (Stricter in production)
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ==========================================
# EMAIL CONFIGURATION (SMTP - Optional)
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@vortexbonus.com"
SMTP_PASS="your-production-app-password"

# ==========================================
# BREVO (Sendinblue) EMAIL SERVICE
# ==========================================
# Use separate production Brevo account
BREVO_API_KEY="xkeysib-production-api-key-here"
BREVO_SENDER_EMAIL="noreply@vortexbonus.com"
BREVO_SENDER_NAME="VortexBonus"

BREVO_VERIFICATION_TEMPLATE_ID=1
BREVO_GENERIC_TEMPLATE_ID=2
BREVO_PASSWORD_RESET_TEMPLATE_ID=3
BREVO_WELCOME_TEMPLATE_ID=4

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# ==========================================
# FRONTEND URL
# ==========================================
FRONTEND_URL="https://vortexbonus.com"

# ==========================================
# SECURITY
# ==========================================
# Enable additional security features in production
ENABLE_RATE_LIMITING=true
ENABLE_HELMET=true
ENABLE_CORS_STRICT=true